@using Syncfusion.Server.Base.Helpers
@model bool
@inject IUserManagement _userManagement

@{
    Layout = null;
    var globalAppSettings = _globalAppSettings;
    var reportServerResourceUrl = globalAppSettings.SystemSettings.CDNLink.TrimEnd('/');
    bool autoOpenOnBoarding = ViewBag.AutoOpenOnBoarding != null ? (bool)ViewBag.AutoOpenOnBoarding : Model;
    if (autoOpenOnBoarding && _identityResponse != null && _identityResponse.User != null && _identityResponse.User.UserId > 0)
    {
        //Ask only until the user has answered or skipped the questionnaire.
        autoOpenOnBoarding = await _userManagement.GetUserOnBoarding(_identityResponse.User.UserId) == null;
    }
}

<div id="onboard-popup-container" class="" data-auto-open="@(autoOpenOnBoarding ? "true" : "false")">
    <iframe id="onboard-popup-iframe" title="[[[Getting started]]]"></iframe>
</div>

<style>
    #onboard-popup-container {
        padding: 0 !important;
        overflow: hidden;
    }

    /* Fallback only: the exact height is set from onboard-dialog.js when the popup opens. */
    #onboard-popup-iframe {
        width: 100%;
        height: 660px;
        border: 0;
        display: block;
    }
</style>

<script nonce="@Context.Items["ScriptNonce"]">
    window.onBoardIframeUrl = "@Url.Action("OnBoard", "OnBoard")";
</script>
<environment include="Development,CloudDevelopment">
    <script nonce="@Context.Items["ScriptNonce"]" asp-append-version="true" src="@reportServerResourceUrl/cdn/scripts/onboard-dialog.js" integrity="@IntegrityTagHelper.GetIntegrity("wwwroot/cdn/scripts/onboard-dialog.js")" crossorigin="anonymous"></script>
</environment>
<environment exclude="Development,CloudDevelopment">
    <script nonce="@Context.Items["ScriptNonce"]" asp-append-version="true" src="@reportServerResourceUrl/cdn/scripts/onboard-dialog.min.js" integrity="@IntegrityTagHelper.GetIntegrity("wwwroot/cdn/scripts/onboard-dialog.min.js")" crossorigin="anonymous"></script>
</environment>
