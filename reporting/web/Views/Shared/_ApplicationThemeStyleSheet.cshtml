@{
    var globalAppSettings = _globalAppSettings;
    var url = new Uri(Context.Request.GetDisplayUrl());
    var requestUrl = url.AbsolutePath.ToString().ToLower();
    var themePreference = _identityResponse.UserPreference.ServerFeatures.ThemeSettings;
    var appCustomtheme = themePreference.ApplicationTheme != string.Empty ? themePreference.ApplicationTheme : string.Empty;
    var dns = url.GetLeftPart(UriPartial.Authority);
}

<link asp-append-version="true" rel="stylesheet" class="application-theme-ref" href="@ServerAppConfig.GetCustomThemeUrl(appCustomtheme, dns, globalAppSettings, _identityResponse, Context)" />
