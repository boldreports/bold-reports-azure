@using Syncfusion.Server.Base
@using Syncfusion.Server.Base.Environment
@inject GlobalAppSettings _globalAppSettings
@{
    var accessDecision = Context.Items["UpgradeSiteAccessDecision"] as UpgradeSiteAccessDecision;
    if (accessDecision == null)
    {
        var upgradeStatus = await new UpgradeExecutionStatusService(_globalAppSettings).GetStatusAsync();
        accessDecision = UpgradeExecutionStatusService.GetSiteAccessDecision(upgradeStatus);
    }

    var upgradeProgress = Context.Items["IsUpgradeInProgress"] as UpgradeInfo;
    if (upgradeProgress == null)
    {
        upgradeProgress = UpgradeExecutionStatusService.UpgradeProgress();
    }

    var tenantName = Context.Request.RouteValues["tenantName"]?.ToString();
    var upgradeDetailsUrl = ServerAppConfig.UseSiteIdentifier && !string.IsNullOrWhiteSpace(tenantName)
        ? Url.Content($"~/{ServerAppConfig.TenantIdentifierPrefix}/{Uri.EscapeDataString(tenantName)}/error/upgrade-execution")
        : Url.Content("~/error/upgrade-execution");

    var idpUrl = ServerAppConfig.GetClientServiceUrl(_globalAppSettings.SystemSettings.IDPUrl, Context);

    var upgradeDetail = idpUrl.TrimEnd('/') + $"/upgrade-center/monitor/{upgradeProgress?.JobId}";
}

@if (accessDecision?.ShowWarningBanner == true)
{
    <div class="upgrade-limited-access-banner" role="status" aria-live="polite" style="background: var(--warning-bg-normal-color); border-bottom: 1px solid var(--warning-border-normal-color); color: var(--primary-text-normal-color); font-size: 13px; line-height: 20px; padding: 10px 24px 10px 96px; position: relative; z-index: 9;">
        <strong>[[[Upgrade is in progress. ]]]</strong>
        <span>[[[Existing Report pages are available in limited mode while the database upgrade issue is being resolved. Some administrative actions may be temporarily unavailable until the upgrade completes successfully.]]]</span>
        <a class="app-hyperlink" href="@upgradeDetailsUrl" style="color: var(--global-link-text-normal-color); margin-left: 8px; text-decoration: underline;">[[[View upgrade details]]]</a>
    </div>
}

@if (upgradeProgress != null && upgradeProgress.IsUpgradeInProgress)
{
    <div class="upgrade-limited-access-banner" role="status" aria-live="polite" style="background: var(--warning-bg-normal-color); border-bottom: 1px solid var(--warning-border-normal-color); color: var(--primary-text-normal-color); font-size: 13px; line-height: 20px; padding: 10px 24px 10px 96px; position: relative; z-index: 9;">
        <strong>[[[Bold Reports is currently undergoing a system upgrade.]]]</strong>
        <span>[[[Please avoid creating or modifying reports, sites, users, and application settings until the upgrade completes.]]]</span>
        <a class="app-hyperlink" href="@upgradeDetail" style="color: var(--global-link-text-normal-color); margin-left: 8px; text-decoration: underline;">[[[View upgrade details]]]</a>
    </div>
}
