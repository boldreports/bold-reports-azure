@using System.Runtime.InteropServices;
@using System.Web;
@{
    var globalAppSettings = _globalAppSettings;
    var tenantAppConfig = new TenantAppConfiguration(globalAppSettings);
    var showSyncfusionBrand = globalAppSettings.SystemSettings.IsShowPoweredBySyncfusion ? "form-group" : "form-group d-none";
    var themeAppearance = _identityResponse.UserPreference.ServerFeatures.ThemeSettings.Appearance;
    var defaultAppLogo = globalAppSettings.SystemSettings.CDNLink.TrimEnd('/') + "/cdn/images/application/" + ServerAppConfig.AppSettings.AppBranding.Identifier + "/" + themeAppearance + "/" + IconFileNames.MainLogo;
    var isDefaultLogo = globalAppSettings.SystemSettings.MainScreenLogo.EndsWith(IconFileNames.MainLogo);
    var appLogo = (globalAppSettings.SystemSettings.MainScreenLogo.EndsWith(IconFileNames.MainLogo) || globalAppSettings.SystemSettings.MainScreenLogo.EndsWith("main_logo.png")) ? defaultAppLogo : globalAppSettings.SystemSettings.MainScreenLogo;

    var defaultFooterLogo = globalAppSettings.SystemSettings.CDNLink.TrimEnd('/') + "/cdn/images/application/" + ServerAppConfig.AppSettings.AppBranding.Identifier + "/" + themeAppearance + "/" + IconFileNames.FooterLogo;
    var isDefaultFooterLogo = !string.IsNullOrEmpty(globalAppSettings.SystemSettings.FooterLogo) && globalAppSettings.SystemSettings.FooterLogo.EndsWith(IconFileNames.FooterLogo);
    var footerLogo = isDefaultFooterLogo ? defaultFooterLogo : globalAppSettings.SystemSettings.FooterLogo;
    var protocolTypes = new List<SelectListItem>
    {
        new SelectListItem { Text = "http", Value = "http", Selected = !globalAppSettings.SystemSettings.IsSecureConnection },
        new SelectListItem { Text = "https", Value = "https", Selected = globalAppSettings.SystemSettings.IsSecureConnection }
    };
    var helpSiteUrl = GlobalAppSettings.GetHelpSiteUrl(HelpSiteUrlNames.DomainBinding);
    var isWindowsPlatform = RuntimeInformation.IsOSPlatform(OSPlatform.Windows);
    var copyrightInformation = HttpUtility.HtmlDecode(globalAppSettings.SystemSettings.CopyrightInformation);
    var organizationName = HttpUtility.HtmlDecode(ViewBag.SystemSettings.OrganizationName);
    var isShowEmailLogo = _globalAppSettings.SystemSettings.IsShowEmailLogo;
    var isShowLoginLogo = _globalAppSettings.SystemSettings.IsShowLoginLogo;
    var isShowFooterLogoCopyRightInfo = _globalAppSettings.SystemSettings.IsShowFooterLogoCopyRightInfo;
}
<script nonce="@Context.Items["ScriptNonce"]">
    var isSitesPage = "true";
    var isShowEmailLogo = @Json.Serialize(isShowEmailLogo);
    var isShowLoginLogo = @Json.Serialize(isShowLoginLogo);
    var isShowFooterLogoCopyRightInfo = @Json.Serialize(isShowFooterLogoCopyRightInfo);
</script>
<div id="look-and-feel-container" class="admin-page-container col-12">
    <div id="organization-block" class="col-12 no-padding">
        <div class="col-md-12 import-area admin-page-header">
            <hgroup class="no-padding">
                <h1 class="h2 page-title">[[[SITE SETTINGS]]]</h1>
                <h5 class="page-description">[[[Rebrand with your company name, logo, domain, time zone, and date-time display formats.]]]</h5>
            </hgroup>
        </div>

        <form id="look-and-feel-form" class="col-md-12 form-horizontal no-padding" autocomplete="off">
            <div class="general-sub-section admin-page-body">
                <h3 class="title sub-section-heading mb-3">[[[General]]]</h3>

                <div class="row mb-4 align-items-center" style="margin-top: 15px;">
                    @Html.Label("site-orgname", "[[[Organization name]]]", new { @class = "col-sm-2 col-form-label app-textbox-label" })
                    <div class="col-sm-4" id="site-orgname-section">
                        <input type="text" id="site-orgname" class="form-control site-orgname-fields"
                               placeholder="[[[Enter your Organization Name]]]"
                               value="@organizationName" data-original-value="@organizationName" />
                    </div>
                </div>
                @if (ServerAppConfig.IsSelfHosted)
                {
                    <div class="row mb-4 align-items-center">
                        <label for="site-base-url" class="col-sm-2 col-form-label app-textbox-label">[[[Site URL]]]</label>
                        <div id = "site-base-url-section" class="col-sm-4">
                            <div class="input-group">
                                <button type="button" class="btn dropdown-toggle selectpicker disabled btn-default" data-bs-toggle="dropdown" data-id="enable-ssl" tabindex="-1" title="@ViewBag.scheme" disabled><span class="filter-option pull-left">@ViewBag.scheme</span>&nbsp;<span class="caret"></span></button>
                                <input type="text" id="site-base-url" name="site-base-url" class="form-control site-url-fields" placeholder="[[[Enter your URL]]]" value="@ViewBag.authority" data-original-value="@ViewBag.authority" disabled />
                            </div>
                        </div>
                        @if (isWindowsPlatform)
                        {
                        <div class="col-4 mb-3" id="help_text" style="display: @ViewBag.icon">
                            <div class="col-sm-2"></div>
                            <div class="col-4 d-flex align-items-end gap-2" style="margin-top:10px">
                                <span id="error_icon" class="su su-info info-settings" title=""></span>
                                <div class="dropdown-menu show p-2" id="ssl-help-message" style="display: none">
                                    [[[The server needs to be hosted in IIS with a valid SSL certificate assigned to it.]]]
                                    @if (!ServerAppConfig.IsHideHelpLink)
                                    {
                                        <span>
                                            [[[Click]]] <a href="@(ServerAppConfig.AppSettings.Documentation.BaseUri + helpSiteUrl)" target="_blank">[[[here]]]</a> [[[for more details.]]]
                                        </span>
                                    }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-sm-2"></div>
                        <div class="col-sm-4">
                            <span class="validation-errors" id="site-url-validation"></span>
                        </div>
                    </div>

                    <input type="hidden" class="hidden-input" id="scheme_value" data-value="@ViewBag.scheme" />

                }
                else
                {
                    <div class="row mb-4 blur-whitelable-content align-items-center">
                        @Html.Label("enable-ssl", "[[[Domain]]]", new { @class = "col-sm-2 col-form-label app-textbox-label" })
                        <div class="col-sm-4 custom-domain-section">
                            <input type="text" id="site_url" name="site_url" disabled
                                   class="form-control site-url-fields"
                                   placeholder="[[[Enter your URL]]]"
                                   value="@ViewBag.SystemSettings.BaseUrl"
                                   data-original-value="@ViewBag.SystemSettings.BaseUrl" />
                        </div>
                        <input type="hidden" class="hidden-input" id="scheme_value" data-value="@ViewBag.scheme" />
                    </div>
                }
             
            </div>

            @await Html.PartialAsync("~/Views/Administration/_DisplaySettings.cshtml")
            
            <div class="branding-sub-section admin-page-body @(ViewBag.ThirdPartyLogins ||  ViewBag.WhiteLabel || ViewBag.CustomDomain ? string.Empty : "unlock-enterprise-features")">
                <h3 class="title col-12  sub-section-heading blur-whitelable-content">[[[Branding]]]</h3>

                <div class="col-6 no-margin no-padding blur-whitelable-content">

                    <div class="form-group highlight-image login-screen-logo" data-image="login-screen">
                        @Html.Label("login-screen-image", "[[[Login screen logo]]]", new { @class = "col-4 app-textbox-label" })
                        <div class="col-8 mb-3">
                            <div class="input-group">
                                <input type="text" id="upload-login-image-textbox" class="form-control filename-text" value="[[[Browse file path]]]" readonly>
                                <span id="upload-login-image-addon" class="input-group-addon">
                                    <div id="upload-login-image" class="settings-upload-button">
                                    </div>
                                </span>
                            </div>
                            <span class="info-text">
                                *[[[200x40 pixels preferred]]]
                            </span>
                            <div id="upload-login-image-textbox-error" class="col-12 validation-error-image has-error hide"></div>
                        </div>
                    </div>

                    <div class="form-group highlight-image header-logo" data-image="header-logo">
                        <label class="col-4 app-textbox-label">[[[Header logo]]]</label>
                        <div class="col-8 mb-3">
                            <div class="input-group">
                                <input type="text" id="upload-main-screen-image-textbox" class="form-control filename-text" value="[[[Browse file path]]]" readonly>
                                <span id="upload-main-screen-image-addon" class="input-group-addon"><div id="upload-Main-screen-image" class="settings-upload-button"></div></span>
                            </div>

                            <span class="info-text">
                                *[[[40x40 pixels preferred]]]
                            </span>
                            <div id="upload-main-screen-image-textbox-error" class="col-12 validation-error-image has-error hide"></div>
                        </div>
                    </div>

                    <div class="form-group highlight-image favicon-logo" data-image="favicon">
                        <label class="col-4 app-textbox-label">[[[Favicon]]]</label>
                        <div class="col-8 mb-3">
                            <div class="input-group">
                                <input type="text" id="upload-favicon-image-textbox" class="form-control filename-text" value="[[[Browse file path]]]" readonly>
                                <span id="upload-favicon-image-addon" class="input-group-addon">
                                    <div id="upload-favicon-image" class="settings-upload-button"></div>
                                </span>
                            </div>
                            <span class="info-text">
                                *[[[40x40 pixels preferred]]]
                            </span>
                            <div id="upload-favicon-image-textbox-error" class="col-12 validation-error-image has-error hide"></div>
                        </div>
                    </div>

                    <div class="form-group highlight-image email-logo" data-image="email-logo">
                        <label class="col-4 app-textbox-label">[[[Email logo]]]</label>
                        <div class="col-8 mb-3">
                            <div class="input-group">
                                <input type="text" id="upload-emaillogo-image-textbox" class="form-control filename-text" value="[[[Browse file path]]]" readonly>
                                <span id="upload-emaillogo-image-addon" class="input-group-addon">
                                    <div id="upload-emaillogo-image" class="settings-upload-button"></div>
                                </span>
                            </div>
                            <span class="info-text">
                                *[[[200x40 pixels preferred]]]
                            </span>
                            <div id="upload-emaillogo-image-textbox-error" class="col-12 validation-error-image has-error hide"></div>
                        </div>
                    </div>
                        <div class="@showSyncfusionBrand blur-whitelable-content">
                            @Html.Label("enablepoweredbysyncfusion", "[[[Show powered by Information]]]", new { @class = "app-textbox-label col-4" })
                            <div class="col-8 mb-3 enablepoweredbysyncfusion switch-align">
                                <span class="material-switch text-left">
                                    <input type="checkbox" id="enablepoweredbysyncfusion" name="enablefooter" @((bool)ViewBag.SystemSettings.IsEnablePoweredBySyncfusion ? "checked" : string.Empty) />
                                    <label for="enablepoweredbysyncfusion" class="label-primary"></label>
                                </span>
                            </div>
                        </div>
                      @if (ServerAppConfig.IsSelfHosted)
                      {
                        <div class="form-group highlight-image footer-logo" data-image="powderedby-logo">
                            <label class="col-4 app-textbox-label">[[[Powered by logo]]]</label>
                            <div class="col-8 mb-3">
                                <div class="input-group">
                                    <input type="text" id="upload-footerlogo-image-textbox" class="form-control filename-text" value="[[[Browse file path]]]" readonly>
                                    <span id="upload-footerlogo-image-addon" class="input-group-addon">
                                        <div id="upload-footerlogo-image" class="settings-upload-button"></div>
                                    </span>
                                </div>
                                <span class="info-text">
                                    *[[[200x40 pixels preferred]]]
                                </span>
                                <div id="upload-footerlogo-image-textbox-error" class="col-12 validation-error-image has-error hide"></div>
                            </div>
                        </div>
                      }
                        <div class="form-group row blur-whitelable-content">
                            @Html.Label("enablecopyrightinfo", "[[[Show copyright information]]]", new { @class = "app-textbox-label col-4" })
                        <div class="col-8 mb-3 enablecopyrightinfo switch-align">
                            <span class="material-switch text-left">
                                <input type="checkbox" id="enablecopyrightinfo" name="enablefooter" @((bool)ViewBag.SystemSettings.IsEnableCopyrightInfo ? "checked" : string.Empty) />
                                <label for="enablecopyrightinfo" class="label-primary"></label>
                            </span>
                        </div>
                        </div>
                      @if (ServerAppConfig.IsSelfHosted)
                      {
                        <div class="form-group highlight-image">
                            <label class="col-4 app-textbox-label">[[[Site copyright information]]]</label>
                            <div class="col-8 mb-3">
                                <input type="text" id="site-copyright" name="site-copyright" class="form-control site-copyright-fields" placeholder="[[[Enter your copyright information]]]" value="@(copyrightInformation.Replace("$$CurrentYear$$", DateTime.UtcNow.Year.ToString()))" data-original-value="@(copyrightInformation.Replace("$$CurrentYear$$", DateTime.UtcNow.Year.ToString()))" />
                            </div>
                            <div class="col-12 no-padding">
                                <div class="col-4"></div>
                                <span class="validation-errors col-8" id="site-copyright-validation"></span>
                            </div>
                            <input type="hidden" class="hidden-input" id="scheme_value" data-value="@ViewBag.scheme">
                        </div>
                       }
                    </div>
                <div class="col-6 text-center blur-whitelable-content">
                    <div id="image-container" class="center-img">
                        <table>
                            <tbody>
                                <tr>
                                    <td class="login-img">
                                        <span data-bs-toggle="tooltip" data-animation="true" class="app-img-container tooltip-container" data-image="login-screen">
                                            <img id="display-login-logo" src="@globalAppSettings.SystemSettings.LoginLogo" height="40" alt="[[[Login screen logo]]]" />
                                        </span>
                                        <div class="applogo-label">[[[Login screen logo]]]</div>
                                    </td>
                                    <td>
                                        <span class="app-img-container favicon tooltip-container" data-bs-toggle="tooltip" data-animation="true" data-image="favicon">
                                            <img id="favicon_logo_img" src="@globalAppSettings.SystemSettings.FavIcon" width="16" height="16" alt="[[[Favicon]]]" />
                                        </span>
                                        <div class="applogo-label">[[[Favicon]]]</div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="separator-img no-padding">
                                        <img src="@Url.Content("~/images/divider_light.png")" alt="divider" />
                                    </td>
                                    <td class="separator-img no-padding">
                                        <img src="@Url.Content("~/images/divider_light.png")" alt="divider" />
                                    </td>
                                </tr>
                                <tr width="200">
                                    <td>
                                        <span class="app-img-container header-icon tooltip-container" data-bs-toggle="tooltip" data-animation="true" data-image="header-logo">
                                            <img id="mainscreen_logo_img" src="@appLogo" height="40" alt="[[[Header logo]]]" />
                                        </span>
                                        <div class="applogo-label">[[[Header logo]]]</div>
                                    </td>
                                    <td class="email-logo-img">
                                        <span class="app-img-container email-icon tooltip-container" data-bs-toggle="tooltip" data-animation="true" data-image="email-logo">
                                            <img id="email_logo_img" src="@globalAppSettings.SystemSettings.EmailLogo" height="40" alt="[[[Email logo]]]" />
                                        </span>
                                        <div class="applogo-label">[[[Email logo]]]</div>
                                    </td>
                                </tr>
                                <tr>
                                    <td id="footer-separator-row" class="separator-img no-padding">
                                        <img src="@Url.Content("~/images/divider_light.png")" alt="divider" />
                                    </td>
                                </tr>
                                @if (ServerAppConfig.IsSelfHosted)
                                {
                                <tr width="200">
                                    <td>
                                        <span id="footer-preview-image" class="app-img-container header-icon tooltip-container" data-bs-toggle="tooltip" data-animation="true" data-image="header-logo">
                                            <img id="powderedby_logo_img" src="@footerLogo" height="40" alt="[[[Powered by logo]]]" />
                                        </span>
                                        <div id="footer-preview-image" class="applogo-label">[[[Powered by logo]]]</div>
                                    </td>
                                </tr>
                                }
                                </tbody>
                        </table>
                    </div>
                </div>

                <div class="blur-whitelable-content col-12 no-padding branding-info">
                    <div class="branding-configuration-header">
                        <h3 class="title sub-section-heading">[[[Email Brand Configuration]]]</h3>
                        <div class="info-message-site-settings">
                            [[[These branding features will appear in the email to the recipient.]]]
                        </div>
                    </div>
                    <div class="col-12 no-padding">
                        <div class="form-group no-margin">
                            <div id="enable-checkbox" class="d-flex align-items-start">
                                @Html.CheckBox("showemaillogo", new { @class = "material-checkbox ums-inherit-branding", @id = "showemaillogo" })
                                @Html.Hidden("showemaillogo")
                                @Html.Label("showemaillogo", "Show Email Logo", new { @class = "app-textbox-label col-2 section-label show-email-logo" })
                                <div class="col-sm-1 col-1 no-padding info-icon-align">
                                    <span class="cursor-type"><span data-bs-toggle="tooltip" class="su su-info" data-placement="right" title="[[[Enabling this option will display the email logo in the email template.]]]"></span></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group no-margin">
                            <div id="enable-checkbox" class="d-flex align-items-start">
                                @Html.CheckBox("showloginlink", new { @class = "material-checkbox ums-inherit-branding", @id = "showloginlink" })
                                @Html.Hidden("showloginlink")
                                @Html.Label("showloginlink", "Show login link", new { @class = "app-textbox-label col-2 section-label show-login-link" })
                                <div class="col-sm-1 col-1 no-padding info-icon-align">
                                    <span class="cursor-type"><span data-bs-toggle="tooltip" class="su su-info" data-placement="right" title="[[[Enabling this option will display login link in the email template.]]]"></span></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group no-margin">
                            <div id="enable-checkbox" class="d-flex align-items-start">
                                @Html.CheckBox("showfooterlogocopyinfo", new { @class = "material-checkbox ums-inherit-branding", @id = "showfooterlogocopyinfo" })
                                @Html.Hidden("showfooterlogocopyinfo")
                                @Html.Label("showfooterlogocopyinfo", "Show footer logo and copyright info", new { @class = "app-textbox-label col-3 section-label show-footer-logo" })
                                <div class="col-sm-1 col-1 no-padding info-icon-align">
                                    <span class="cursor-type"><span class="su su-info" data-bs-toggle="tooltip" data-placement="right" title="[[[Enabling this option will display the footer logo and copyright information in the email template.]]]"></span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>   
           
        </form>
    </div>

    <div class="admin-page-actions col-lg-12 col-md-12 no-margin">
        <a href="@Url.Action("Index","Home")" class="secondary-button app-btn-secondary float-end" id="cancel-site-settings" title="">[[[Cancel]]]</a>
        <button type="button" title="" id="update-mail-settings" name="UpdateSystemSettings" class="primary-button app-btn-primary float-end update-system-settings">
            [[[Save]]]
        </button>
    </div>
</div>

@*@if (!ServerAppConfig.IsSelfHosted && ViewBag.CustomDomain)
{
    @Html.Partial("~/Views/Administration/_CustomDomain.cshtml")
}*@