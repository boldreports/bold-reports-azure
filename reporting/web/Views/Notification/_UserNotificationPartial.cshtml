@{
    Layout = null;
    var globalAppSettings = _globalAppSettings;
    var idPAvatarUrl = globalAppSettings.SystemSettings.IDPUrl + "/User/Avatar";
    var targetValue = @ServerAppConfig.SameTabReportRender ? "_self" : "_blank";
}

<script nonce="@Context.Items["ScriptNonce"]">
    var userSystemnotificationUrl = "@Url.Action("getnotificationsonrequest", "notification")";
    var viewUrl = "@Url.Action("Reports", "Reports")";
    @*var viewWidgetUrl = "@Url.Action("widgets", "widgets")";*@
</script>

<div id="user-notification-container" class="col-12 no-padding" style="display:none">
    <div class="notification-header col-12">
        <span id="close-user-notification" class="su su-arrow-back"></span>
        <span class="notification-title">[[[Notifications]]]</span>
        <a id="user-notification-settings-link" class="notification-setting-link" href="@Url.Action("Profilepage","User")" style="display:none;">[[[SETTINGS]]]</a>
    </div>
    <div id="notification-content" class="notification-content-container-partial col-12 no-padding">
        <ul id="notification-list-ul" class="notification-list-ul"></ul>
        <div id="user-notification-loader" class="notification-loader" style="display:none;">
            <svg x="0px" y="0px" width="24px" height="30px" viewBox="0 0 24 30" style="enable-background:new 0 0 50 50;" xml:space="preserve">
            <rect x="0" y="10" width="4" height="10" fill="#0565FF" opacity="0.2">
            <animate attributeName="opacity" attributeType="XML" values="0.2; 1; .2" begin="0s" dur="0.8s" repeatCount="indefinite" />
            <animate attributeName="height" attributeType="XML" values="10; 20; 10" begin="0s" dur="0.8s" repeatCount="indefinite" />
            <animate attributeName="y" attributeType="XML" values="10; 5; 10" begin="0s" dur="0.8s" repeatCount="indefinite" />
                </rect>
            <rect x="8" y="10" width="4" height="10" fill="#0565FF" opacity="0.2">
            <animate attributeName="opacity" attributeType="XML" values="0.2; 1; .2" begin="0.15s" dur="0.8s" repeatCount="indefinite" />
            <animate attributeName="height" attributeType="XML" values="10; 20; 10" begin="0.15s" dur="0.8s" repeatCount="indefinite" />
            <animate attributeName="y" attributeType="XML" values="10; 5; 10" begin="0.15s" dur="0.8s" repeatCount="indefinite" />
                </rect>
            <rect x="16" y="10" width="4" height="10" fill="#0565FF" opacity="0.2">
            <animate attributeName="opacity" attributeType="XML" values="0.2; 1; .2" begin="0.3s" dur="0.8s" repeatCount="indefinite" />
            <animate attributeName="height" attributeType="XML" values="10; 20; 10" begin="0.3s" dur="0.8s" repeatCount="indefinite" />
            <animate attributeName="y" attributeType="XML" values="10; 5; 10" begin="0.3s" dur="0.8s" repeatCount="indefinite" />
                </rect>
            </svg>
        </div>
        <div id="no-more-notification-info" class="additional-content col-12" style="display:none;">
            <div>
                <h5>[[[No more notifications found]]]</h5>
            </div>
        </div>
        <div id="no-notification-info" class="additional-content" style="display:none;">
            <div>
                <img src="@GlobalAppSettings.CdnDomain/static/default-pages/v1/notifications.svg" />
                <h5>[[[Notification]]]</h5>
                <p>[[[When your team starts working on things, notifications will show up here.]]]</p>
                <a href="@Url.Action("Profilepage","User")">[[[Notification settings]]]</a>
            </div>
        </div>
    </div>
</div>

<div id="user-notification-backdrop" style="display: none;"></div>

<script>
    var notificationItemTypeReport = @((int) ItemType.Report);
    var notificationLogTypeAdded = @((int) ItemCommentLogType.Added);
    var notificationLogTypeEdited = @((int) ItemCommentLogType.Edited);
    var notificationLogTypeDeleted = @((int) ItemCommentLogType.Deleted);
    var notificationLogTypeUserMention = @((int) ItemCommentLogType.UserMention);
    var notificationLogTypeReplied = @((int) ItemCommentLogType.Replied);
</script>