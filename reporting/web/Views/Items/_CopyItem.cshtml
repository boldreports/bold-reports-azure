                                    <label class="col-5 no-left-padding text-left text-label" id="select_Category_label_drillthroughreports">[[[Category]]]</label>
                                    <label class="col-4 no-left-padding text-left text-label" id="select_Report_label_drillthroughreports">[[[Report]]]</label>
                                </div>
                                <ul class="list-unstyled" id="change_drillthroughreport_list"></ul>
                            </div>
                            <input type="hidden" id="ItemIdHidden" value="@(ViewBag.ItemId ?? Context.Request.Form["itemId"].ToString())" />
