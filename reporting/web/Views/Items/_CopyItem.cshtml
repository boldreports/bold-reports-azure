                                <div class="col-8 no-padding">
                                    @Html.CheckBox("overwrite_report")
                                    <label for="overwrite_report" class="toggle-space">
                                        <span class="checkbox-text">[[[Overwrite]]]</span>
                                    </label>
                                    <div class="copy-overwrite-warning d-flex align-items-start" style="margin-top:8px;padding-top:2px;">
                                        <span class="su su-warning-alt" style="color:#d97706; margin-right:8px;padding-top:2px;"></span>
                                        <div style="color: #806b75;border-radius: 2px;padding: 2px;border: solid 1px #e8e4e4;line-height: normal;font-size: x-small;width: 265px;">
                                            [[[When enabled, any existing report, dataset, or data source with the same name in the target site will be replaced. This may also affect other reports that depend on the current dataset or data source in the target site.]]]
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        <div id="copyreport_advance_option" style="display:none;">
                            <div id="copyreport_shared_dataset">
                                <div class="col-12 padding20 no-bottom-padding no-top-padding" id="action-datasource-label-division">
                                    <hr id="copy_report_dataset_separator" />
                                    <div id="dataset_info">[[[This report is designed with shared dataset. You can change the dataset and save the copy of it.]]]</div>
                                    <label class="col-3 no-padding text-right text-label">[[[Dataset Name]]]</label>
                                    <label class="col-3 text-right text-label" id="select_dataset_label">[[[Select Dataset]]]</label>
                                </div>
                                <ul class="list-unstyled" id="shared_dataset_list"></ul>
                            </div>

                            <div id="copyreport_shared_datasource">
                                <div class="col-12 padding20 no-bottom-padding no-top-padding" id="action-ds-label-division">
                                    <hr id="copy_report_datasource_separator" />
                                    <div id="datasource_info">[[[This report is designed with shared data source. You can change the data source and save the copy of it.]]]</div>
                                    <label class="col-3 no-padding text-right text-label">[[[Data Source Name]]]</label>
                                    <label class="col-4 text-label" id="select_datasource_label">[[[Select Data Source]]]</label>
                                </div>
                                <ul class="list-unstyled" id="shared_datasource_list"></ul>
                            </div>
                            <div id="copyreport_subreport">
                                <div class="col-12 padding20 no-bottom-padding no-top-padding" id="action-mappedsubreports-label-divisions">
                                    <hr id="copy_report_mappedsubreports_separator" />
                                    <div id="subreport_info">[[[This report is designed with subreport. You can change the subreport and save the copy of it.]]]</div>
                                    <label class="col-3 padding20 no-bottom-padding no-top-padding no-right-padding text-left text-label">[[[SubReport]]]</label>
                                    <label class="col-5 no-left-padding text-left text-label" id="select_Category_label_subreports">[[[Category]]]</label>
