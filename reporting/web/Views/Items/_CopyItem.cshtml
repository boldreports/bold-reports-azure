                            <input type="hidden" id="userIdHidden" value="@identityResponse.User.UserId" />
                        </div>
                </form>
            }
            <div class="col-12 dialog-footer no-right-padding no-left-padding dialog-footer-position" id="action-button-division" style="display: flex !important; justify-content: space-between; align-items: center; min-height: 50px;">
                <div class="col-6" style="display: flex; align-items: center;">
                    <span class="ErrorMessage text-left"></span>
                    <span class="SuccessMessage"></span>
                    @{ if (ViewBag.Action == "Copy")
                        {
                            <input type="button" id="copyreport_advance_button" title="" class="app-button app-secondary-button app-btn-secondary" value="[[[Advanced]]]" style="margin-right: 5px;" />
                        }
                    }
                </div>
                    <div class="col-6 rightAlign" style="display: flex; justify-content: flex-end; gap: 10px;">
                    @{
                        if (ViewBag.Action == "Copy")
                        {
                            <input type="button" title="" id="CopyButton" class="app-button app-primary-button app-btn-primary" value="[[[Copy]]]" />
                        }
                        else if (ViewBag.Action == "Clone")
                        {
                            <input type="button" id="CloneButton" title="" class="app-button app-primary-button app-btn-primary" value="[[[Clone]]]" />
                        }
                    }
                    <input type="button" id="CancelButton" title="" class="app-button app-secondary-button app-btn-secondary" value="[[[Cancel]]]" />
                </div>
            </div>

        }
        else
        {
            <div class="dialog-body col-12 no-padding">
                <div class="col-12 no-left-padding padding20 no-right-padding bottom-margin30">
                    <div class="permission-denied">@TempData["ErrorMessage"]</div>
                </div>
                <div class="col-12 dialog-footer no-right-padding no-left-padding dialog-footer-position" id="action-button-division">
                    <div class="col-12 no-padding text-center">
                        <input type="button" id="CancelButton" title="" class="app-button app-secondary-button app-btn-secondary" value="[[[OK]]]" />
                    </div>
                </div>
            </div>
        }
        <environment include="Development,CloudDevelopment">
            <script nonce="@Model" asp-append-version="true" src="~/js/localizationcontent.js?c=@System.Globalization.CultureInfo.CurrentCulture"></script>
        </environment>
        <environment exclude="Development,CloudDevelopment">
            <script nonce="@Model" asp-append-version="true" src="~/js/localizationcontent.js?c=@System.Globalization.CultureInfo.CurrentCulture"></script>
        </environment>
    </div>

    <script nonce="@Model">
        $(document).ready(function () {
            // Wire up Cancel and Close buttons
            $('#CancelButton').on('click', function() {
                if (window.parent && window.parent.$) {
                    try {
                        window.parent.$("#ItemAction").ejDialog("close");
                    } catch (e) {
                        // Fallback: just hide the dialog
                        window.parent.$('#ItemAction').hide();
                    }
                } else {
                    window.close();
                }
            });

            $('.PopupClose').on('click', function(e) {
                e.preventDefault();
                if (window.parent && window.parent.$) {
                    try {
                        window.parent.$("#ItemAction").ejDialog("close");
                    } catch (e) {
                        window.parent.$('#ItemAction').hide();
                    }
                }
            });
            var className = $(".copy-move-category");
            var categories = @Json.Serialize(ViewBag.CategoryDetails);
            if (categories && categories.length > 0) {
                $('.select-create-type input[name=categoryType][value="1"]').prop('disabled', false);
            }
            else {
                $('.select-create-type input[name=categoryType][value="1"]').prop('disabled', true);
            }

            // Category initialization is now handled by the tenant selection change event
            window.IsCopyOrMoveDashboard = true;
            window.$('#ItemAction_wrapper').ejWaitingPopup("hide");
        });
        function copyCategoryValueChange(className) {
            var dropDownTreeInstance = document.querySelector('.e-dropdowntree').ej2_instances[0];
            var selectedElement = $(".e-list-item[aria-selected='true']");
            var levels = parseInt(selectedElement.attr("aria-level"));
            var selectedItemsText = [];
            for (var i = 1; i < levels; i++) {
                var text = selectedElement.closest(".e-list-item[aria-level='" + i + "']").find(".e-list-text")[0].innerText;
                selectedItemsText.push(text);
            }
            selectedItemsText.push(dropDownTreeInstance.currentText)
            var combinedText = selectedItemsText.join(' / ');
            className.find("input.e-dropdowntree").val(combinedText);
        }
    </script>
    <script nonce="@Model">
        // Internal tenants loaded from server
        var internalTenants = @Json.Serialize(ViewBag.Tenant);

        $(document).ready(function () {
            var siteName = '@siteName';

            // Initialize the tenant dropdown with internal tenants by default
            populateTenantDropdown(internalTenants, siteName);

            // Wire up publishSite (Internal/External) change
            $('#publishSite').on('change', function () {
                onPublishSiteTypeChange();
            });

            // Initialize selectpicker for publishSite
            $('#publishSite').selectpicker('destroy');
            $('#publishSite').selectpicker();

            window.$('#ItemAction_wrapper').ejWaitingPopup("hide");
        });

        function onPublishSiteTypeChange() {
            var siteType = parseInt($('#publishSite').val());
            if (siteType === PublishTypeEnum.External) {
                // Show "+" add button
                $('#add-external-sites-copy').show();
                // Force text-input category for external sites — never call GetCategory
                // $('#multiTenantCategoryDiv').show();
                // $('#singleTenantCategoryDiv').hide();
                // $('#add-new-category').hide();
                // Load external sites into tenant dropdown
                loadExternalSitesIntoTenantDropdown();
                updateCategoryFieldVisibility();
            } else {
                // Hide "+" add button, reload internal tenants
                $('#add-external-sites-copy').hide();
                populateTenantDropdown(internalTenants, '');
                updateCategoryFieldVisibility();
            }
        }

        function loadExternalSitesIntoTenantDropdown() {
            $.ajax({
                type: 'GET',
                url: getExternalSitesUrl,
                success: function (result) {
                    if (result.Status && result.Result) {
                        // Map external sites: use ClientId as value so backend can match externalSite.ClientId == site.TenantId
                        var externalTenants = result.Result.map(function (s) {
                            return { TenantName: s.Name, TenantId: s.ClientId };
                        });
                        populateTenantDropdown(externalTenants, '');
                    } else {
                        // No external sites yet — clear list so user knows to add one
                        populateTenantDropdown([], '');
                    }
                },
                error: function () {
                    populateTenantDropdown([], '');
                }
            });
        }

        function populateTenantDropdown(tenants, preSelectName) {
            var tenantSelect = $('#tenantList');
            tenantSelect.selectpicker('destroy');
            tenantSelect.empty();

            if (tenants && tenants.length > 0) {
                for (var t = 0; t < tenants.length; t++) {
                    var isSelected = tenants[t].TenantName === preSelectName ? 'selected' : '';
                    tenantSelect.append('<option value="' + tenants[t].TenantName + '" ' + isSelected + '>' + tenants[t].TenantName + '</option>');
                }
            }

            tenantSelect.selectpicker();

            // Wire up change event for tenant selection (re-attach after rebuild)
            tenantSelect.off('change.copyitem').on('change.copyitem', function () {
                updateCategoryFieldVisibility();
                loadCategoriesForSelectedTenant();
            });

            loadCategoriesForSelectedTenant();
        }

        // Dialog for adding a new External Site (Copy-specific, isolated from global dialog)
        var _copyExternalSiteDialogBound = false;
        var _copyExternalSiteDialogInstance = null;
        function openAddExternalSiteDialog() {
            if (!_copyExternalSiteDialogBound) {
                // Use innerHTML as string content — more reliable than DOM element ref
                var formHtml = document.getElementById('get-external-site-content').innerHTML;

                var container = document.createElement('div');
                container.id = 'copy-external-site-dialog-host';
                document.body.appendChild(container);

                var dialog = new ejs.popups.Dialog({
                    header: '[[[Add External Site]]]',
                    content: formHtml,
                    buttons: [
                        {
                            click: function () { saveCopyExternalSite(dialog); },
                            buttonModel: { isPrimary: true, content: '[[[Save]]]' }
                        },
                        {
                            click: function () {
                                clearAddExternalSiteForm();
                                dialog.hide();
                            },
                            buttonModel: { content: '[[[Cancel]]]' }
                        }
                    ],
                    animationSettings: { effect: 'Zoom' },
                    width: '600px',
                    showCloseIcon: true,
                    isModal: true,
                    beforeClose: function() { clearAddExternalSiteForm(); }
                });
                dialog.appendTo(container);
                _copyExternalSiteDialogBound = true;
                _copyExternalSiteDialogInstance = dialog;
            }
            if (_copyExternalSiteDialogInstance) {
                _copyExternalSiteDialogInstance.show();
            }
        }

        function clearAddExternalSiteForm() {
            var dlg = document.getElementById('get-external-site-content');
            if (!dlg) { return; }
            $(dlg).find('#external-site-name, #external-client-id, #external-client-secret, #external-site-url').val('');
            $(dlg).find('.name-validation-message, .clientid-validation-message, .client-secret-validation-message, .site-url-validation-message').html('');
            $(dlg).find('input').removeClass('has-error');
            $(dlg).find('.form-input-field').removeClass('has-error');
        }

        function saveCopyExternalSite(dialog) {
            // Scope selectors to the dialog container (form content is inside dialog, not main DOM)
            var dlg = $('#get-external-site-content');
            var requestData = {
                Name: $('#external-site-name').val().trim(),
                ClientId: $('#external-client-id').val().trim(),
                ClientSecret: $('#external-client-secret').val().trim(),
                SiteURL: $('#external-site-url').val().trim()
            };
            if (!requestData.Name || !requestData.ClientId || !requestData.ClientSecret || !requestData.SiteURL) {
                return;
            }
            $.ajax({
                type: 'POST',
                url: addExternalSitesUrl,
                data: { externalSite: requestData },
                success: function (result) {
                    if (result.Status) {
                        if (result.Data) {
                            dlg.find('.name-validation-message').html(window.Server.App.LocalizationContent.SiteNameExist || 'Site name already exists.');
                            return;
                        }
                        if (!result.Result) {
                            var errMsg = result.IsInValidSitecredential
                                ? (window.Server.App.LocalizationContent.InValidExternalSite || 'Invalid site credentials.')
                                : result.IsSiteAlreadyExist
                                    ? (window.Server.App.LocalizationContent.ExternalSiteExist || 'External site already exists.')
                                    : (window.Server.App.LocalizationContent.ExternalSiteUnavailable || 'External site unavailable.');
                            dlg.find('.site-url-validation-message').html(errMsg);
                            return;
                        }
                        clearAddExternalSiteForm();
                        dialog.hide();
                        loadExternalSitesIntoTenantDropdown();
                    }
                }
            });
        }
        
        function updateCategoryFieldVisibility() {
            var selectedTenants = $('#tenantList').val();
            var selectedCount = selectedTenants ? selectedTenants.length : 0;
            
            if (selectedCount > 1) {
                // Multiple tenants selected: show text input, hide dropdown tree and add-new-category button
                $("#multiTenantCategoryDiv").show();
                $("#singleTenantCategoryDiv").hide();
                $("#add-new-category").hide();
            } else if (selectedCount === 1) {
                // Single tenant selected: show dropdown tree and add-new-category button if available
                $("#multiTenantCategoryDiv").hide();
                $("#singleTenantCategoryDiv").show();
                if (@Json.Serialize(canCreateCategory)) {
                    $("#add-new-category").show();
                }
            } else {
                // No tenant selected: show dropdown tree but hide add-new-category button
                $("#multiTenantCategoryDiv").hide();
                $("#singleTenantCategoryDiv").show();
                $("#add-new-category").hide();
            }
        }
        
        function loadCategoriesForSelectedTenant() {
            var selectedTenants = $('#tenantList').val();
            var selectedCount = selectedTenants ? selectedTenants.length : 0;
            
            // Only load categories if exactly 1 tenant is selected
            if (selectedCount === 1) {
                var tenantName = selectedTenants[0];
                var categories = @Json.Serialize(ViewBag.CategoryDetails);
                
                // Reinitialize the DropDownTree with categories
                var dropDownTreeInstance = document.querySelector('#CategoryList');
                if (dropDownTreeInstance != undefined && dropDownTreeInstance != null && dropDownTreeInstance.ej2_instances != undefined) {
                    dropDownTreeInstance.ej2_instances[0].destroy();
                }
                
                var DropDownTreeObj = new ejs.dropdowns.DropDownTree({
                    fields: { dataSource: categories, value: 'Id', text: 'Name', child: 'SubCategory' },
                    select: function () { copyCategoryValueChange($(".copy-move-category")); },
                    value: [categories[0].Id.toString()],
                    destroyPopupOnHide: false,
                    showClearButton: false,
                    placeholder: 'Select category',
                    allowFiltering: true,
                });
                
                DropDownTreeObj.appendTo("#CategoryList");
                $("#add-new-category [data-toggle='tooltip']").tooltip();
            }
        }
        
        function clearCategorySelection() {
            var dropDownTreeInstance = document.querySelector('#CategoryList');
            if (dropDownTreeInstance != undefined && dropDownTreeInstance != null && dropDownTreeInstance.ej2_instances != undefined) {
                dropDownTreeInstance.ej2_instances[0].destroy();
            }
            $('#CategoryList').val('');
        }
    </script>
    <script nonce="@Model">
