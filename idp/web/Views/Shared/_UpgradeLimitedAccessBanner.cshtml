@using Syncfusion.Server.Base
@using Syncfusion.Server.Base.Core
@using Syncfusion.Server.Base.DataClasses.OnPremise
@{

    var accessDecision = Context.Items["UpgradeSiteAccessDecision"] as UpgradeSiteAccessDecision;

    // Determine which products have upgrades in progress
    var biUpgradeProgress = UpgradeInfoManagement.GetUpgradeDetailsFromCache(GlobalAppSettings.SystemSettings?.UpgradeCenter?.Products?.BI);
    var reportsUpgradeProgress = UpgradeInfoManagement.GetUpgradeDetailsFromCache(GlobalAppSettings.SystemSettings?.UpgradeCenter?.Products?.Reports);
    
    var biUpgradeInProgress = biUpgradeProgress != null && biUpgradeProgress.IsUpgradeInProgress;
    var reportsUpgradeInProgress = reportsUpgradeProgress != null && reportsUpgradeProgress.IsUpgradeInProgress;
    
    // Determine product-specific messaging
    string productName = "Bold BI";
    string bannerMessage = T["Please avoid creating or modifying dashboards, sites, users, and application settings until the upgrade completes."].Value;
    var activeUpgradeProgress = biUpgradeProgress; // Default to BI for URL generation
    
    if (biUpgradeInProgress && reportsUpgradeInProgress)
    {
        productName = "Bold Products";
        bannerMessage = T["Please avoid creating or modifying dashboards, reports, sites, users, and application settings until the upgrade completes."].Value;
    }
    else if (reportsUpgradeInProgress)
    {
        productName = "Bold Reports";
        bannerMessage = T["Please avoid creating or modifying reports, sites, users, and application settings until the upgrade completes."].Value;
        activeUpgradeProgress = reportsUpgradeProgress;
    }

    var idPUrl = await GlobalAppSettings.GetClientServiceUrl(GlobalAppSettings.SystemSettings.InternalAppUrls.Idp, Context);
    var upgradeCenterUrl = $"{idPUrl.TrimEnd('/')}/upgrade-center/monitor/{activeUpgradeProgress?.JobId}";
}

@if (accessDecision?.ShowWarningBanner == true )
{
    <div class="upgrade-limited-access-banner" role="status" aria-live="polite" style="background: var(--warning-bg-normal-color); border-bottom: 1px solid var(--warning-border-normal-color); color: var(--primary-text-normal-color); font-size: 13px; line-height: 20px; padding: 10px 24px 10px 96px; position: relative;">
        <strong>@T["Upgrade is in progress. "]</strong>
        <span>@T["Existing IDP pages are available in limited mode while the database upgrade issue is being resolved. Some administrative actions may be temporarily unavailable until the upgrade completes successfully."]</span>
        <a class="app-hyperlink" href="@Url.Content("~/error/upgrade-execution")" style="color: var(--global-link-text-normal-color); margin-left: 8px; text-decoration: underline;">@T["View upgrade details"]</a>
    </div>
}

@if (biUpgradeInProgress || reportsUpgradeInProgress)
{
    <div class="upgrade-limited-access-banner" role="status" aria-live="polite" style="background: var(--warning-bg-normal-color); border-bottom: 1px solid var(--warning-border-normal-color); color: var(--primary-text-normal-color); font-size: 13px; line-height: 20px; padding: 10px 24px 10px 96px; position: relative;">
        <strong>@T["{0} is currently undergoing a system upgrade.", productName]</strong>
        <span>@bannerMessage</span>
        <a class="app-hyperlink" href="@upgradeCenterUrl" style="color: var(--global-link-text-normal-color); margin-left: 8px; text-decoration: underline;">@T["View upgrade details"]</a>
    </div>
}
